<mxfile host="app.diagrams.net" type="device">
  <diagram id="navidet-pipeline" name="navidet pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="navidet 통합 파이프라인 (현재 방법) — 공유 Backbone/Neck + 2개 Head 계열" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== Knowledge Distillation (training only) ===================== -->
        <mxCell id="distillBox" value="학습 시에만 — Knowledge Distillation" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="370" height="155" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="DINOv3 Teacher&#10;ViT-B/16 (frozen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="350" y="160" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="distillLoss" value="Distill Loss&#10;(cosine, α-schedule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="525" y="165" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- ===================== Shared trunk ===================== -->
        <mxCell id="rgb" value="RGB 입력&#10;(예: 1920×1080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="letterbox" value="Letterbox&#10;640×640" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="185" y="335" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="backbone" value="Backbone&#10;timm CSP (n/s/m/l/x)&#10;→ P3,P4,P5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="320" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="neck" value="FPN Neck&#10;(torchvision)&#10;→ N3,N4,N5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="525" y="320" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== 6DoF branch (top) ===================== -->
        <mxCell id="lbl6dof" value="① 6DoF Pose 계열 (Det6DoF)" style="text;html=1;align=left;fontStyle=1;fontSize=13;fontColor=#bf8f00;" vertex="1" parent="1">
          <mxGeometry x="740" y="70" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pose6dofhead" value="Pose6DoFHead&#10;2D box+cls / Rotation(6D) / 3D Size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="depthhead" value="DepthHead (N3)&#10;→ Dense Depth Map (H/2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="175" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="camK" value="Camera Intrinsics K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="245" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="unproj" value="decode_pose&#10;box중심 Z 샘플 + K → Unprojection&#10;→ Translation t(X,Y,Z)&#10;Rot(6D→R)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pose6dofout" value="6DoF Pose (R | t)&#10;+ 3D Size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="140" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== 2D pose branch (bottom) ===================== -->
        <mxCell id="lblpose" value="② 2D Multi-task / Pose 계열 (MultiTaskDet) — COCO 벤치마크 대상" style="text;html=1;align=left;fontStyle=1;fontSize=13;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="740" y="445" width="520" height="20" as="geometry" />
        </mxCell>
        <mxCell id="mtlhead" value="MultiTaskHead&#10;box+cls / keypoints (17×3, COCO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="740" y="475" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="decodenms" value="Decode + NMS&#10;(letterbox→원본 좌표 복원)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="475" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="persons" value="Persons + 17 keypoints&#10;(score 포함)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="475" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cocoeval" value="COCOeval (OKS)&#10;AP / AR @ val2017" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="1240" y="585" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="published" value="vs Published&#10;(YOLOv8-pose / HRNet / ViTPose …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="1240" y="665" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cocogt" value="COCO val2017 GT&#10;person_keypoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="585" width="170" height="55" as="geometry" />
        </mxCell>

        <!-- ===================== Training data (COCO conversion) ===================== -->
        <mxCell id="cococonv" value="COCO json → YOLO-pose 변환&#10;(coco2yolo_pose)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="475" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- ===================== Edges ===================== -->
        <mxCell id="e_rgb_lb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="rgb" target="letterbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_lb_bb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="letterbox" target="backbone"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb_neck" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="backbone" target="neck"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- distill edges (dashed, training only) -->
        <mxCell id="e_lb_teacher" value="img" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="letterbox" target="teacher"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_teacher_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="teacher" target="distillLoss"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb_loss" value="student feat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="backbone" target="distillLoss"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- neck → heads -->
        <mxCell id="e_neck_6h" value="N3,N4,N5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="neck" target="pose6dofhead"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_neck_depth" value="N3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="neck" target="depthhead"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_neck_mtl" value="N3,N4,N5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="neck" target="mtlhead"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 6DoF decode -->
        <mxCell id="e_6h_unproj" value="Rot/Size/box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pose6dofhead" target="unproj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_depth_unproj" value="depth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="depthhead" target="unproj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_k_unproj" value="K" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="camK" target="unproj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_unproj_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="unproj" target="pose6dofout"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 2D pose decode + eval -->
        <mxCell id="e_mtl_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="mtlhead" target="decodenms"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_dec_persons" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="decodenms" target="persons"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_persons_eval" value="예측" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="persons" target="cocoeval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gt_eval" value="GT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cocogt" target="cocoeval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_eval_pub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cocoeval" target="published"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- training data feeding backbone -->
        <mxCell id="e_conv_bb" value="train (YOLO-pose)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="cococonv" target="backbone"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="범례:  실선 = 추론(forward) 흐름    ┊ 점선 = 학습 시에만(증류·데이터 변환)" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="600" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
