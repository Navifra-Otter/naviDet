        <mxCell id="in_depth" value="Depth PNG (uint16)&#10;depth/*.png  × 0.001 → m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1E88E5;" vertex="1" parent="1">
