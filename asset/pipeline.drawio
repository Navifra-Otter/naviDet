          <mxGeometry x="380" y="785" width="380" height="54" as="geometry" />
        </mxCell>

        <mxCell id="loss" value="Pose6DoFLoss&#10;TaskAlignedAssigner →&#10;box · dfl · obj · cls · rot · size · depth · trans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;" vertex="1" parent="1">
